{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SendyKit",
  "colors": {
    "primary": "#D4A843",
    "light": "#E8C564",
    "dark": "#B8922E"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/sendykit-light.svg",
    "dark": "/logo/sendykit-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Site",
        "href": "https://sendykit.dev"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/Philoveracity/sendykit"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get SendyKit",
      "href": "https://sendykit.dev/pricing"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/exoskeleton"
            ]
          },
          {
            "group": "Self-Hosted",
            "pages": [
              "self-hosted/licensing"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "billing/overview",
              "billing/agent-payments"
            ]
          },
          {
            "group": "Readiness",
            "pages": [
              "readiness/doctor"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/agent-usage"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors",
              "api-reference/rate-limiting"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference/introduction",
          "icon": "code"
        },
        {
          "anchor": "Pricing",
          "href": "https://sendykit.dev/pricing",
          "icon": "credit-card"
        }
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Philoveracity/sendykit",
      "x": "https://x.com/sendykit"
    }
  }
}
